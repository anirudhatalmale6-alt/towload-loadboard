# ═══════════════════════════════════════════════════════════════════════════
#  Clean URLs — nothing in this app ever shows a .php extension.
#
#    /                        -> tow.html            (stranded motorist)
#    /tow                     -> index.html          (operator dashboard)
#    /join                    -> join.html           (tow operator signup)
#    /support                 -> support.html        (public support page)
#    /connect/return|refresh  -> connect.html        (back from Stripe)
#    /track/{token}           -> tow.html?job={token}
#    /api/auth/login          -> api/auth.php?action=login
#    /api/calls/board?radius= -> api/calls.php?action=board&radius=
#    /api/calls               -> api/calls.php
#    /webhooks/stripe         -> webhooks/stripe.php
#
#  Works in a subfolder without knowing the folder name, so renaming the
#  directory when the brand is chosen needs no edit here.
# ═══════════════════════════════════════════════════════════════════════════

RewriteEngine On

# bot24.io's parent rules would otherwise hijack this subfolder.
RewriteOptions IgnoreInherit

# ─── Realtime ───────────────────────────────────────────────────────────────
# The socket server listens on 127.0.0.1 only and is reached through here.
#
# This has to be the FIRST rule. A WebSocket handshake is an ordinary GET until
# the moment it is upgraded, so any earlier rule that matches /socket.io/ would
# swallow it and the connection would fail in a way that looks like the server
# being down.
#
# Two lines, and both are needed. socket.io opens on long-polling and upgrades
# to a real socket a moment later; the first line carries the upgraded socket,
# the second carries the polling that precedes it and the fallback for any
# network that blocks WebSockets — hotel wifi, some corporate proxies, a few
# mobile carriers. Losing the second line means it works everywhere except the
# places where it matters.
#
# mod_proxy in .htaccess is enabled on this box — bot24.io has done exactly
# this since July. That is why no panel setting and no separate subdomain are
# needed: same origin, so no cross-origin handling and nothing extra to renew.
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^socket\.io/(.*)  "ws://127.0.0.1:3003/socket.io/$1"   [P,L]
RewriteRule ^socket\.io/(.*)  "http://127.0.0.1:3003/socket.io/$1" [P,L,QSA]

# PHP runs as CGI/FPM here, which silently drops the Authorization header —
# every authenticated API call comes back "Authorization required" without this.
# Both forms are set because which one survives depends on the SAPI.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Anyone hitting a .php URL directly gets bounced to the clean one, so the
# extension can never leak into a link, a bookmark or a search index.
# The folder group is optional for the same reason as the deny rules below:
# this reads the full request line, and the app now sits at a domain root where
# there is no folder in front of `api/`.
RewriteCond %{THE_REQUEST} "\s/+(.*?/)?(api|webhooks)/([a-z-]+)\.php(?:\?action=([a-z-]+))?" [NC]
RewriteRule ^ /%1%2/%3/%4? [R=301,L]

# Real files and directories win (assets, uploads).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# The bare domain is the customer's page — they are the volume, and the address
# on a business card or an ad should be the one a stranded motorist can be told
# over the phone. The operator app moved to /tow to make room for it.
#
# NOTE: there is deliberately no redirect from the old /tow to the new /. There
# cannot be — /tow is now where the operator app lives. Anything still pointing
# at towsling.com/tow for customers (ads, QR codes, print) has to be repointed
# at the bare domain by hand.
RewriteRule ^tow/?$                          index.html [L]
RewriteRule ^join/?$                         join.html [L]
RewriteRule ^track/([a-f0-9]{32})/?$         tow.html?job=$1 [L]

# Terms and privacy have to be readable without an account — a tower deciding
# whether to sign up and a customer deciding whether to confirm both need them
# before they have one. QSA keeps ?doc=customer|tower|privacy.
RewriteRule ^terms/?$                        terms.html [QSA,L]
RewriteRule ^privacy/?$                      terms.html?doc=privacy [L]

# Public support page. Stripe requires a customer support URL before a platform
# can take real money, and it is also the only route to a human for a stranded
# motorist who has no account and no job number.
RewriteRule ^support/?$                      support.html [L]

# Where Stripe returns a towing company after bank setup. Both of these URLs
# have been handed to Stripe since the Connect code was written, and neither
# route existed — so finishing bank setup landed on an Apache 404 with no sign
# that anything had been saved.
RewriteRule ^connect/(return|refresh)/?$     connect.html?state=$1 [L]

# Platform control panel.
RewriteRule ^admin/?$                        admin.html [L]

# API + webhooks
RewriteRule ^api/([a-z-]+)/([a-z-]+)/?$      api/$1.php?action=$2 [QSA,L]
RewriteRule ^api/([a-z-]+)/?$                api/$1.php [QSA,L]
RewriteRule ^webhooks/([a-z-]+)/?$           webhooks/$1.php [QSA,L]

# The bare domain. DirectoryIndex rather than a rewrite: mod_dir resolves the
# directory request before mod_rewrite gets a per-directory rule for an empty
# URI, which otherwise leaves the folder as a 403.
DirectoryIndex tow.html

# ─── Hardening ──────────────────────────────────────────────────────────────
# Config, includes and the schema must never be fetchable over HTTP.
# `ws` is the realtime server: Node source, its package files and the .env that
# holds the shared secret. It runs from the operator's home directory, not from
# here — it only lives in the deploy tree so it version-controls with everything
# else, and nothing in it should ever be fetchable.
#
# The optional `(.*/)?` is load-bearing. These read on the FULL request path,
# not the path relative to this directory, and the app moved from a subfolder
# (/towload/config/…) to a domain root (/config/…). `^/.*/` demanded a segment
# before `config`, so at the root every one of these rules silently stopped
# matching — the database password would have been a public URL the moment the
# domain changed, with nothing failing to show it.
RedirectMatch 404 ^/(.*/)?(config|includes|migrations|ws)/.*$
RedirectMatch 404 ^/(.*/)?schema\.sql$
RedirectMatch 404 ^/(.*/)?\.git

# Compliance uploads: EIN letters, insurance certificates, driver's licences.
# Belt and braces — uploads/.htaccess denies these too, and the only way to read
# one is api/docs/file, which checks who is asking. Any single layer failing
# still leaves them unreachable.
RedirectMatch 404 ^/(.*/)?uploads/.*$

<FilesMatch "\.(sql|log|md|bak|bak-.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Caching ────────────────────────────────────────────────────────────────
# The host's default was `Cache-Control: max-age=2592000` on every .js — thirty
# days — while the HTML that references them expired in ten minutes. So a
# returning visitor picked up a new page within minutes and kept month-old
# JavaScript alongside it. That is how a page came to ask the translation file
# for a key it did not yet contain, and print the key on screen.
#
# The filenames here carry no content hash, so the only correct answer is: ask
# every time. The answer is almost always a 304 with an empty body, which costs
# a round trip and no bandwidth.
# mod_expires is what was emitting the thirty days, and it emits BOTH an
# Expires header and its own Cache-Control. Setting ours on top of it left two
# conflicting Cache-Control headers on every response, which is not something to
# leave to a browser's judgement. Switch it off for this folder and state the
# policy once, here.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|html|json|webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Expires
        Header unset Pragma
    </FilesMatch>

    # The service worker decides how long everything ELSE is cached for. A stale
    # one cannot be corrected by shipping a new anything.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Icons are a different case: they change only when their filename does, and
    # the installed app fetches them on every cold start.
    <FilesMatch "\.(png|jpg|jpeg|gif|svg|woff2?|ico)$">
        Header set Cache-Control "public, max-age=604800"
        Header unset Expires
    </FilesMatch>
</IfModule>

# No directory listings.
Options -Indexes
