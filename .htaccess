# ═══════════════════════════════════════════════════════════════════════════
#  Clean URLs — nothing in this app ever shows a .php extension.
#
#    /                        -> index.html          (dispatcher board)
#    /tow                     -> tow.html            (stranded motorist)
#    /join                    -> join.html           (tow operator signup)
#    /track/{token}           -> tow.html?job={token}
#    /api/auth/login          -> api/auth.php?action=login
#    /api/calls/board?radius= -> api/calls.php?action=board&radius=
#    /api/calls               -> api/calls.php
#    /webhooks/stripe         -> webhooks/stripe.php
#
#  Works in a subfolder without knowing the folder name, so renaming the
#  directory when the brand is chosen needs no edit here.
# ═══════════════════════════════════════════════════════════════════════════

RewriteEngine On

# bot24.io's parent rules would otherwise hijack this subfolder.
RewriteOptions IgnoreInherit

# PHP runs as CGI/FPM here, which silently drops the Authorization header —
# every authenticated API call comes back "Authorization required" without this.
# Both forms are set because which one survives depends on the SAPI.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Anyone hitting a .php URL directly gets bounced to the clean one, so the
# extension can never leak into a link, a bookmark or a search index.
RewriteCond %{THE_REQUEST} "\s/+(.*?)/(api|webhooks)/([a-z-]+)\.php(?:\?action=([a-z-]+))?" [NC]
RewriteRule ^ /%1/%2/%3/%4? [R=301,L]

# Real files and directories win (assets, uploads).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Consumer-facing pages. /tow is what the Google ads point at; /track/{token}
# is the link a customer gets by text and comes back to.
RewriteRule ^tow/?$                          tow.html [L]
RewriteRule ^join/?$                         join.html [L]
RewriteRule ^track/([a-f0-9]{32})/?$         tow.html?job=$1 [L]

# Terms and privacy have to be readable without an account — a tower deciding
# whether to sign up and a customer deciding whether to confirm both need them
# before they have one. QSA keeps ?doc=customer|tower|privacy.
RewriteRule ^terms/?$                        terms.html [QSA,L]
RewriteRule ^privacy/?$                      terms.html?doc=privacy [L]

# Platform control panel.
RewriteRule ^admin/?$                        admin.html [L]

# API + webhooks
RewriteRule ^api/([a-z-]+)/([a-z-]+)/?$      api/$1.php?action=$2 [QSA,L]
RewriteRule ^api/([a-z-]+)/?$                api/$1.php [QSA,L]
RewriteRule ^webhooks/([a-z-]+)/?$           webhooks/$1.php [QSA,L]

# The app itself. DirectoryIndex rather than a rewrite: mod_dir resolves the
# directory request before mod_rewrite gets a per-directory rule for an empty
# URI, which otherwise leaves /towload/ as a 403.
DirectoryIndex index.html

# ─── Hardening ──────────────────────────────────────────────────────────────
# Config, includes and the schema must never be fetchable over HTTP.
RedirectMatch 404 ^/.*/(config|includes|migrations)/.*$
RedirectMatch 404 ^/.*/schema\.sql$
RedirectMatch 404 ^/.*/\.git

# Compliance uploads: EIN letters, insurance certificates, driver's licences.
# Belt and braces — uploads/.htaccess denies these too, and the only way to read
# one is api/docs/file, which checks who is asking. Any single layer failing
# still leaves them unreachable.
RedirectMatch 404 ^/.*/uploads/.*$

<FilesMatch "\.(sql|log|md|bak|bak-.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# No directory listings.
Options -Indexes
